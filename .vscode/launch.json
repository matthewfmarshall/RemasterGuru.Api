{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RemasterGuru.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RemasterGuru.Api/bin/Debug/net10.0/RemasterGuru.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/RemasterGuru.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      }
    },
    {
      "name": "RemasterGuru.Worker",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-worker",
      "program": "${workspaceFolder}/src/RemasterGuru.Worker/bin/Debug/net10.0/RemasterGuru.Worker.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/RemasterGuru.Worker",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  ],
  "compounds": [
    {
      "name": "Api + Worker",
      "configurations": ["RemasterGuru.Api", "RemasterGuru.Worker"],
      "stopAll": true
    }
  ]
}
