# Copy to .env for docker compose (gitignored).
# SQL Server requires a strong SA password (upper, lower, digit, symbol).
SA_PASSWORD=RemasterGuru_Dev1!

# Auth0 (optional — when unset, API uses X-User-Id dev auth)
# Auth0__Domain=your-tenant.us.auth0.com
# Auth0__Audience=https://api.remasterguru.com
# App__WebBaseUrl=http://localhost:3000
# HuggingFace__SpaceUrl=https://your-space.hf.space
# Cors__AllowHuggingFaceSpaceHosts=true

# HF / SQLite staging (optional)
# Database__Provider=Sqlite
# ConnectionStrings__Default=Data Source=/data/remasterguru.db

# Stripe (test mode) — prefer user secrets on the API project (see README).
# Stripe__SecretKey=sk_test_...
# Stripe__WebhookSecret=whsec_...
# Stripe__PublishableKey=pk_test_...
