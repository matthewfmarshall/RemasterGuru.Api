            "type": "string",
            "nullable": true
          },
          "templateId": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PatchAssetRequest": {
        "type": "object",
        "properties": {
          "caption": {
            "type": "string",
            "nullable": true
          },
          "displayVersion": {
            "type": "string",
            "nullable": true,
            "description": "Album grid and book preview: original or restored"
          }
        },
        "additionalProperties": false
      },
      "RegisterAssetRequest": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "caption": {
            "type": "string",
            "nullable": true
          }
